{
  "name": "cursor2api",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "OpenAI- and Anthropic-compatible API gateway for Cursor Composer models.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NGLSG/cursor2api.git"
  },
  "homepage": "https://github.com/NGLSG/cursor2api#readme",
  "bugs": {
    "url": "https://github.com/NGLSG/cursor2api/issues"
  },
  "scripts": {
    "server": "node server.mjs",
    "start:local": "node server.mjs start",
    "stop:local": "node server.mjs stop",
    "dev": "node server.mjs start",
    "build": "vite build",
    "build:client": "vite build --config vite.client.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "sdk:opencode-bridge": "node scripts/cursor-sdk-local-agent-bridge.mjs",
    "sdk:responses": "node scripts/cursor-sdk-responses-proxy.mjs",
    "test": "vitest run",
    "test:sidecar": "vitest run sidecar",
    "db:migrate": "bun sidecar/migrate.ts",
    "db:import": "bun sidecar/migrate.ts --import",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p sidecar/tsconfig.json",
    "dev:client": "vite --host 127.0.0.1"
  },
  "keywords": [
    "cursor",
    "composer",
    "openai",
    "chat-completions",
    "responses-api",
    "postgresql",
    "redis"
  ],
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.27",
    "ioredis": "^6.0.0",
    "lucide": "^0.557.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.0.15"
  }
}
